{
  "name": "squash_ratings",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wellperion": "vite --mode wellperion",
    "dev:seoul": "vite --mode seoul",
    "build": "tsc -b && vite build",
    "build:wellperion": "tsc -b && vite build --mode wellperion --outDir dist/wellperion",
    "build:seoul": "tsc -b && vite build --mode seoul --outDir dist/seoul",
    "build:all": "npm run build && npm run build:wellperion && npm run build:seoul",
    "scrape": "node tools/scrape-ksf.mjs",
    "build:seoul-data": "node tools/build-seoul.mts",
    "ladder": "node tools/build-ladder.mts",
    "lint": "oxlint",
    "preview": "vite preview",
    "club": "node tools/fetch-club.mts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "xlsx": "^0.18.5"
  }
}
